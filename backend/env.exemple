# ======================================================================
# Zemy backend — modele de configuration
# Copier ce fichier en ".env" (non versionne) et renseigner les valeurs.
# ======================================================================

# --- Django -----------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,zemybackend.sinustic.com

# --- Base de donnees --------------------------------------------------
DB_ENGINE=mysql
DB_NAME=zemy
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Redis / Celery ---------------------------------------------------
REDIS_URL=

# ======================================================================
# MONITORING — Alertes Slack (exceptions, bugs, erreurs, lenteurs)
# ======================================================================
# URL du webhook entrant Slack. C'est un SECRET : ne jamais le committer.
# Sans cette valeur, le monitoring reste inactif.
SLACK_WEBHOOK_URL=

# Interrupteur general du monitoring.
MONITORING_ENABLED=True

# Nom affiche dans les alertes pour distinguer les environnements.
MONITORING_ENVIRONMENT=production
MONITORING_SERVICE_NAME=zemy-backend

# Niveau minimal remonte : DEBUG / INFO / WARNING / ERROR / CRITICAL
MONITORING_MIN_LEVEL=ERROR

# Anti-spam : une meme erreur n'est renvoyee qu'une fois toutes les N secondes,
# et le canal ne recoit jamais plus de MONITORING_RATE_LIMIT alertes par minute.
MONITORING_DEDUP_WINDOW=300
MONITORING_RATE_LIMIT=30

# Detection des lenteurs : seuil en millisecondes (0 = desactive).
MONITORING_SLOW_REQUEST_MS=3000

# Options bruyantes, desactivees par defaut.
MONITORING_NOTIFY_CLIENT_ERRORS=False
MONITORING_NOTIFY_CELERY_RETRY=False

# Exclusions supplementaires (listes separees par des virgules).
MONITORING_IGNORED_LOGGERS=
MONITORING_IGNORED_PATHS=

# Signaler l arret d un worker Celery (se declenche aussi a chaque deploiement).
MONITORING_NOTIFY_CELERY_SHUTDOWN=True
