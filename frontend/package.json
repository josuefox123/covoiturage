{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node -e \"const fs = require('fs'); const p = 'node_modules/react-async-hook/package.json'; if (fs.existsSync(p)) { let c = fs.readFileSync(p, 'utf8'); c = c.replace('react-async-hook.esm.js', 'dist/react-async-hook.esm.js'); fs.writeFileSync(p, c); } const ws = 'node_modules/ws/index.js'; if (fs.existsSync(ws)) { let w = fs.readFileSync(ws, 'utf8'); if (!w.includes('WebSocket.WebSocket')) { w = w.replace('module.exports = WebSocket;', 'WebSocket.WebSocket = WebSocket;\\nmodule.exports = WebSocket;'); fs.writeFileSync(ws, w); } } const expBase = 'node_modules/expo/tsconfig.base.json'; if (fs.existsSync(expBase)) { fs.copyFileSync(expBase, 'node_modules/expo/tsconfig.base'); }\""
  },
