# Exclude node_modules (EAS will install them on the server)
node_modules/

# Exclude Android and iOS local build artifacts
android/
ios/

# Exclude local export output
dist/

# Exclude test files
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Exclude local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Exclude local git info
.git/

# Exclude dev logs and misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
database_schema.md
replace_alerts.js
test.js
CLAUDE.md
AGENTS.md
README.md
.claude/
