{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -Pandroid.enableMinifyInReleaseBuilds=false -Pandroid.enableShrinkResourcesInReleaseBuilds=false"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://zemybackend.sinustic.com/api",
        "EAS_BUILD_NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "ORG_GRADLE_PROJECT_android.enableMinifyInReleaseBuilds": "false",
        "ORG_GRADLE_PROJECT_android.enableShrinkResourcesInReleaseBuilds": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://zemybackend.sinustic.com/api",
        "EAS_BUILD_NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
